# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Python files
.venv/
venv/

# macOS files
*.DS_Store

# IDE files
.idea/
.vscode/
.history/

# Vim temp/swap files
*~
*.swp
*.swo

# PyInstaller
